{
  "name": "wysiwyg-markdown-editor",
  "displayName": "Markdown Word — WYSIWYG Markdown Editor",
  "description": "Word 式所见即所得 Markdown 编辑器：两行图标化 Ribbon、可视化表格、图片粘贴落盘、Confluence 式斜杠菜单、代码块（含 PL/SQL）等宽字体",
  "version": "1.7.1",
  "publisher": "EmonZhang3438",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emon9426/VSCodeMarkDownEditor.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "word",
    "rich text",
    "table"
  ],
  "activationEvents": [
    "onCustomEditor:wysiwygMarkdownEditor",
    "onView:markdownWordOutline"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "wysiwygMarkdownEditor",
        "displayName": "Markdown Word 编辑器",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "wysiwygMarkdown.toggleMode",
        "title": "Markdown Word: 切换编辑模式 (WYSIWYG / 源码 / 分屏)"
      },
      {
        "command": "wysiwygMarkdown.insertTable",
        "title": "Markdown Word: 插入表格"
      },
      {
        "command": "wysiwygMarkdown.insertImage",
        "title": "Markdown Word: 插入图片"
      },
      {
        "command": "wysiwygMarkdown.insertTOC",
        "title": "Markdown Word: 插入当前日期时间"
      },
      {
        "command": "wysiwygMarkdown.pageSetup",
        "title": "Markdown Word: 页面设置…（纸张尺寸 / 背景色 / 条纹）"
      },
      {
        "command": "wysiwygMarkdown.exportHtml",
        "title": "Markdown Word: 导出为 HTML（自包含单文件）"
      },
      {
        "command": "wysiwygMarkdown.exportPdf",
        "title": "Markdown Word: 导出为 PDF（生成打印就绪页面并在浏览器中打印）"
      },
      {
        "command": "wysiwygMarkdown.gotoHeading",
        "title": "Markdown Word: 大纲跳转（内部命令）"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownWord",
          "title": "Markdown Word",
          "icon": "media/outline-icon.svg"
        }
      ]
    },
    "views": {
      "markdownWord": [
        {
          "id": "markdownWordOutline",
          "name": "大纲",
          "contextualTitle": "Markdown Word"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "markdownWordOutline",
        "contents": "用 **Markdown Word** 打开任意 .md 文件后，此处将显示文档大纲（标题树）。\n[打开 Markdown 文件](command:workbench.action.files.openFile)"
      }
    ],
    "configuration": {
      "title": "Markdown Word",
      "properties": {
        "markdownWord.defaultMode": {
          "type": "string",
          "default": "wysiwyg",
          "enum": [
            "wysiwyg",
            "source",
            "split"
          ],
          "description": "打开文档时的默认编辑模式"
        },
        "markdownWord.image.saveFolder": {
          "type": "string",
          "default": "./images",
          "description": "粘贴/拖拽图片的保存目录（相对文档，持久化保证：绝不引用临时地址）"
        },
        "markdownWord.image.fileNamePattern": {
          "type": "string",
          "default": "${docName}-${timestamp}",
          "description": "图片文件名模板，可用 ${docName} 与 ${timestamp}"
        },
        "markdownWord.slashMenu.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 Confluence 式斜杠命令菜单（/ 唤出）"
        },
        "markdownWord.table.defaultHeader": {
          "type": "boolean",
          "default": true,
          "description": "新建表格默认包含表头行"
        },
        "markdownWord.editor.fontFamilyLatin": {
          "type": "string",
          "default": "",
          "description": "正文西文字体（拉丁字符与数字）；留空跟随 VS Code。与中文字体组合回退链，中英文自动各用其字体"
        },
        "markdownWord.editor.fontFamilyCJK": {
          "type": "string",
          "default": "Microsoft YaHei",
          "description": "正文中文字体（CJK 字符）：Microsoft YaHei / SimSun / KaiTi / SimHei / FangSong / Source Han Sans SC 等"
        },
        "markdownWord.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "AI 助手（复用 VS Code 已登录的 GitHub Copilot，经官方 Language Model API；关闭则隐藏全部 AI 入口）"
        },
        "markdownWord.ai.model": {
          "type": "string",
          "default": "",
          "description": "AI 模型（留空跟随 Copilot 默认；填写模型 id 或名称关键字，如 gpt / claude）"
        },
        "markdownWord.ui.language": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "zh-CN", "en"],
          "description": "界面语言：auto 跟随 VS Code 显示语言；切换即时生效"
        },
        "markdownWord.page.size": {
          "type": "string",
          "default": "fit",
          "enum": [
            "fit",
            "a3",
            "a4",
            "a5",
            "b5",
            "letter",
            "legal",
            "custom"
          ],
          "enumDescriptions": [
            "适应屏幕（默认，窗口缩放自动跟随）",
            "A3 · 1123px @96dpi",
            "A4 · 794px",
            "A5 · 559px",
            "B5 · 667px",
            "Letter · 816px",
            "Legal · 816px",
            "自定义宽度（配合 page.customWidth）"
          ],
          "description": "页面尺寸（仅视图层，切换后内容流式重排，不写入 Markdown）"
        },
        "markdownWord.page.customWidth": {
          "type": "number",
          "default": 794,
          "minimum": 400,
          "maximum": 1600,
          "description": "自定义纸张宽度（px，仅 page.size = custom 时生效）"
        },
        "markdownWord.page.background": {
          "type": "string",
          "default": "auto",
          "description": "页面背景色：auto（跟随主题）/ white / green（护眼绿）/ parchment（羊皮纸）/ iceblue（冰蓝）/ 自定义十六进制色（如 #C7EDCC）"
        },
        "markdownWord.page.pattern": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "lines",
            "grid",
            "dots"
          ],
          "enumDescriptions": [
            "无",
            "横线（信纸，对齐行高）",
            "方格",
            "点阵"
          ],
          "description": "页面条纹（与背景色叠加渲染，仅影响显示，不写入 Markdown）"
        }
      }
    }
  },
  "scripts": {
    "test": "node test/unit/run.js",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.19.0",
    "jsdom": "^29.1.1"
  }
}
